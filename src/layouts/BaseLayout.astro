---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getSettings } from "../lib/sanity";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "European-type Maine Coons with presence, structure, and steady temperaments. A home-based cattery in Northern Virginia.", ogImage = "/images/og-image.jpg" } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://pamperedfelinemainecoons.com");

const settings = await getSettings();

function smsHref(phone: string): string {
  const digits = phone.replace(/[^\d]/g, "");
  const e164 = digits.length === 10 ? `+1${digits}` : `+${digits}`;
  return `sms:${e164}`;
}

const localBusinessJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Pampered Feline Maine Coons",
  "description": "CFA-registered Maine Coon cattery in Northern Virginia specializing in European-line kittens with cardiac ultrasound and genetic health testing.",
  "url": "https://pamperedfelinemainecoons.com",
  "email": "pamperedfelinemainecoons@gmail.com",
  ...(settings.phone ? { "telephone": settings.phone } : {}),
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "VA",
    "addressCountry": "US",
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Northern Virginia" },
    { "@type": "AdministrativeArea", "name": "Washington, DC Metro Area" },
  ],
  "priceRange": "$3,600-$4,500",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || "https://pamperedfelinemainecoons.com").href} />
    <meta property="og:site_name" content="Pampered Feline Maine Coons" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || "https://pamperedfelinemainecoons.com").href} />

    <title>{title}</title>

    <!-- Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-326548451"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-326548451');
      gtag('config', 'G-C747E3LE1X');
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={localBusinessJson} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    {settings.phone && (
      <a
        href={smsHref(settings.phone)}
        class="fixed z-40 bottom-4 left-1/2 -translate-x-1/2 md:left-auto md:right-6 md:translate-x-0 md:bottom-6 flex items-center gap-2 px-5 py-2.5 rounded-full bg-obsidian/95 border border-gold/30 text-bone text-xs font-medium tracking-widest uppercase shadow-lg backdrop-blur-sm hover:border-gold/60 hover:bg-obsidian transition-colors"
        aria-label={`Text us at ${settings.phone}`}
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        Text us
      </a>
    )}
  </body>
</html>
