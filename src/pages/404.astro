---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | Pampered Feline Maine Coons">
  <section class="bg-obsidian py-24 md:py-36 lg:py-44">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <p class="text-xs md:text-sm font-medium tracking-[0.3em] uppercase text-gold/70 mb-6">
        404
      </p>
      <h1 class="font-heading text-4xl md:text-5xl font-semibold text-bone mb-6 leading-tight">
        Page Not Found
      </h1>
      <p class="text-bone/70 text-lg leading-relaxed mb-10">
        The page you are looking for does not exist or has been moved. If you were looking for one of our kittens, they may have already found their home.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="px-8 py-3.5 bg-bone text-obsidian text-sm font-medium tracking-widest uppercase hover:bg-bone/85 transition-colors"
        >
          Return Home
        </a>
        <a
          href="/#waitlist"
          class="px-8 py-3.5 border border-bone/25 text-bone/70 text-sm font-medium tracking-widest uppercase hover:border-bone/55 hover:text-bone transition-colors"
        >
          Join the Waitlist
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
