---
import { getSettings } from "../lib/sanity";

const settings = await getSettings();
const currentYear = new Date().getFullYear();

const email = settings.contactEmail ?? "[PLACEHOLDER]";

function telHref(phone: string): string {
  return `tel:${phone.replace(/[^\d+]/g, "")}`;
}

function instagramUrl(handle: string): string {
  return `https://instagram.com/${handle}`;
}
---

<footer class="bg-obsidian text-ivory/80">
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8">
      <div class="text-center md:text-left">
        <p class="font-heading text-2xl font-semibold text-ivory mb-2">
          Pampered Feline Maine Coons
        </p>
        <p class="text-sm text-ivory/60">
          Northern Virginia
        </p>
        <p class="text-xs mt-2">
          <a href="/maine-coon-kittens-northern-virginia" class="text-ivory/40 hover:text-gold transition-colors">
            Maine Coon Kittens in Northern Virginia
          </a>
        </p>
      </div>

      <div class="text-center md:text-right space-y-2">
        <p class="text-sm">
          Email: <a href={`mailto:${email}`} class="text-ivory/60 hover:text-gold transition-colors">{email}</a>
        </p>
        {settings.phone && (
          <p class="text-sm">
            Call/Text: <a href={telHref(settings.phone)} class="text-ivory/60 hover:text-gold transition-colors">{settings.phone}</a>
          </p>
        )}
        {settings.instagramHandle && (
          <p class="text-sm">
            <a href={instagramUrl(settings.instagramHandle)} target="_blank" rel="noopener noreferrer" class="text-ivory/60 hover:text-gold transition-colors">Instagram</a>
          </p>
        )}
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-ivory/10 text-center">
      <div class="flex items-center justify-center gap-10 mb-6">
        <a href="https://cfa.org" target="_blank" rel="noopener noreferrer" class="opacity-70 hover:opacity-100 transition-opacity duration-300" aria-label="Cat Fanciers' Association">
          <img src="/images/logos/cfa-logo.svg" alt="CFA — Cat Fanciers' Association" height="90" class="h-[90px] w-auto" />
        </a>
        <a href="https://tica.org" target="_blank" rel="noopener noreferrer" class="opacity-70 hover:opacity-100 transition-opacity duration-300" aria-label="The International Cat Association">
          <img src="/images/logos/tica-logo.svg" alt="TICA — The International Cat Association" height="90" class="h-[90px] w-auto" />
        </a>
      </div>
      <p class="text-xs text-ivory/40">
        &copy; {currentYear} Pampered Feline Maine Coons. All rights reserved.
      </p>
    </div>
  </div>
</footer>
