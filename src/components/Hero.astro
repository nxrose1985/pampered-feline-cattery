---
interface HeroImage {
  asset: { url: string };
  alt?: string;
}

interface Props {
  heroImage?: string;
  heroImages?: HeroImage[];
  phone?: string;
}

const { heroImage, heroImages, phone } = Astro.props;

function smsHref(phone: string): string {
  const digits = phone.replace(/[^\d]/g, "");
  const e164 = digits.length === 10 ? `+1${digits}` : `+${digits}`;
  return `sms:${e164}`;
}

function sanityHeroUrl(url: string): string {
  if (!url || !url.includes("cdn.sanity.io")) return url;
  return `${url}?w=1920&q=80&auto=format`;
}

const rotatingImages = (heroImages ?? [])
  .map((img) => ({ url: sanityHeroUrl(img.asset?.url), alt: img.alt ?? "" }))
  .filter((img) => img.url);
---

<section id="hero-section" class="relative min-h-[90vh] flex flex-col items-center justify-center bg-obsidian overflow-hidden">

  {rotatingImages.length > 0 ? (
    <div class="absolute inset-0" id="hero-bg-rotator" aria-hidden="true">
      {rotatingImages.map((img, i) => (
        <img
          src={img.url}
          alt={img.alt}
          class="hero-bg-slide absolute inset-0 w-full h-full object-cover"
          data-hero-slide={i}
          style={i === 0 ? "opacity: 1;" : "opacity: 0;"}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
      ))}
      <div class="absolute inset-0 hero-image-overlay"></div>
    </div>
  ) : heroImage ? (
    <div class="absolute inset-0">
      <img src={heroImage} alt="" class="w-full h-full object-cover" aria-hidden="true" />
      <div class="absolute inset-0 bg-obsidian/75"></div>
    </div>
  ) : (
    <div class="absolute inset-0 hero-bg" aria-hidden="true"></div>
  )}

  <div class="absolute inset-0 hero-grain pointer-events-none" aria-hidden="true"></div>

  <div id="hero-content" class="relative z-10 text-center px-6 max-w-5xl mx-auto">
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold text-bone leading-[1.05] mb-8 tracking-tight">
      Ready to meet your<br class="hidden sm:block" /> soul kitten?
    </h1>
    <p class="font-body text-base md:text-lg text-bone/55 max-w-sm mx-auto leading-relaxed tracking-wide mb-10">
      Championship European Bloodline Maine Coons, raised in our home
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/kitten-application"
        class="px-8 py-3.5 bg-gold text-obsidian text-sm font-medium tracking-widest uppercase hover:bg-gold/85 transition-colors"
      >
        Apply for a Kitten
      </a>
      <a
        href="/#kittens"
        class="px-8 py-3.5 border border-bone/25 text-bone/70 text-sm font-medium tracking-widest uppercase hover:border-bone/55 hover:text-bone transition-colors"
      >
        View Available Kittens
      </a>
    </div>

    {phone && (
      <p class="mt-6 text-sm text-bone/50">
        <a href={smsHref(phone)} class="text-bone/75 hover:text-gold underline underline-offset-2 transition-colors">
          {phone}
        </a> — call or text anytime. We're always here to answer questions.
      </p>
    )}
  </div>

  <div id="hero-scroll-indicator" class="absolute bottom-16 md:bottom-8 inset-x-0 flex flex-col items-center gap-2" aria-hidden="true">
    <span class="text-[10px] tracking-[0.4em] uppercase font-body font-medium text-bone/40">Scroll</span>
    <svg class="w-4 h-4 text-bone/40 scroll-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const content = document.getElementById("hero-content");
  const indicator = document.getElementById("hero-scroll-indicator");
  const section = document.getElementById("hero-section");

  // Fade-in hero text on load
  if (content) {
    gsap.from(content, { opacity: 0, duration: 1.1, ease: "power2.out", delay: 0.15 });
  }

  // Fade out scroll indicator as user scrolls into the page
  if (indicator && section) {
    gsap.to(indicator, {
      opacity: 0,
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "+=180",
        scrub: true,
      },
    });
  }

  // Cycle through the rotating hero background images. Motion-sensitive
  // visitors (prefers-reduced-motion) still see every uploaded photo, just
  // swapped instantly instead of crossfaded, so there's no continuous
  // animation but the full set of images is still shown.
  const rotator = document.getElementById("hero-bg-rotator");
  if (rotator) {
    const slides = Array.from(rotator.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (slides.length > 1) {
      let current = 0;
      const HOLD_SECONDS = 6;
      const FADE_SECONDS = 1.5;

      setInterval(() => {
        const next = (current + 1) % slides.length;
        if (prefersReducedMotion) {
          slides[current].style.opacity = "0";
          slides[next].style.opacity = "1";
        } else {
          gsap.to(slides[current], { opacity: 0, duration: FADE_SECONDS, ease: "power1.inOut" });
          gsap.to(slides[next], { opacity: 1, duration: FADE_SECONDS, ease: "power1.inOut" });
        }
        current = next;
      }, HOLD_SECONDS * 1000);
    }
  }
</script>

<style>
  .hero-bg {
    background: radial-gradient(ellipse at 38% 35%, #1c1410 0%, #0e0b09 45%, #0A0A0A 100%);
  }

  /* Flat 58% black keeps every image legible at every edge (scroll indicator,
     phone line included); the radial layer adds extra contrast right behind
     the headline/subhead/CTAs where it matters most. */
  .hero-image-overlay {
    background:
      radial-gradient(ellipse 70% 60% at 50% 46%, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0) 100%),
      rgba(0, 0, 0, 0.58);
  }

  .hero-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    mix-blend-mode: overlay;
    opacity: 0.5;
  }

  .scroll-chevron {
    animation: chevron-drift 2.4s ease-in-out infinite;
  }

  @keyframes chevron-drift {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(5px); opacity: 0.65; }
  }
</style>
