---
import KittenCard from "./KittenCard.astro";
import ScrollReveal from "./ScrollReveal.astro";
import { getKittensByLitter, getSettings } from "../lib/sanity";
import type { Kitten } from "../lib/sanity";

interface Props {
  litterId?: string;
}

const { litterId = "march-2026" } = Astro.props;

const [sanityKittens, settings] = await Promise.all([
  getKittensByLitter(litterId),
  getSettings(),
]);

const fallbackKittens = [
  { name: "Helion",   slug: "helion",   color: "Cream Shaded Silver",               sex: "Male",   status: "Available" as const, isPolydactyl: false, litter: litterId, price: 4000, reservationFee: 500, availableDate: "2026-06-04", order: 1, about: "Helion carries himself like he knows exactly how good-looking he is. His cream shaded silver coat shifts from pale champagne at the tips to a bright silver undercoat — in the right light he almost glows. He is steady and confident without being pushy, the kind of cat who settles into a new home on his own terms and then decides he owns it. He will do well in an active household and is likely to become his person's shadow. Named for the High Lord of the Day Court — radiant, unhurried, and completely sure of himself." },
  { name: "Tarquin",  slug: "tarquin",  color: "Cream Shaded Silver",               sex: "Male",   status: "Available" as const, isPolydactyl: false, litter: litterId, price: 4000, reservationFee: 500, availableDate: "2026-06-04", order: 2, about: "Tarquin is the easygoing one. Where his cream shaded silver littermates are bold, Tarquin is warm — quick to purr, slow to startle, and genuinely happy in anyone's lap. His coat has the same luminous silver-cream shimmer as Helion's but his personality is softer, more collaborative. He would thrive as a companion for another cat or as the gentle anchor of a busy family home. Named for the High Lord of the Summer Court — generous, open, and deeply kind." },
  { name: "Kallias",  slug: "kallias",  color: "Poly Cream Shaded Silver (6/6/6/6)", sex: "Male",  status: "Available" as const, isPolydactyl: true,  litter: litterId, price: 4500, reservationFee: 500, availableDate: "2026-06-04", order: 3, about: "Kallias is the one who stops people mid-scroll. The cream shaded silver coat is already striking, but add six toes on each front paw and he becomes something genuinely rare. He is curious and physical — the kitten who investigates everything, climbs everything, and figures things out faster than you expect. His extra toes give him remarkable dexterity; don't be surprised if he learns to open things. He needs a home that will keep up with him. Named for the High Lord of the Winter Court — precise, capable, and quietly extraordinary." },
  { name: "Amren",    slug: "amren",    color: "Blue Tortie",                       sex: "Female", status: "Available" as const, isPolydactyl: false, litter: litterId, price: 3600, reservationFee: 500, availableDate: "2026-07-08", order: 7, about: "Amren is compact, watchful, and quietly intense. Her blue tortie coat is softer in tone than Morrigan's — more muted blue, less contrast — which gives her a silvery, ethereal quality that suits her personality. She observes before she engages, sizes up a room before she enters it, and reserves her affection for people who have earned it. When she decides you're worth her time, you'll know. Named for the ancient, unknowable second-in-command of the Night Court — small, still, and not to be underestimated." },
];

// Sort: Available first, then Reserved. Within each group, sort by display order ascending.
function sortKittens(list: any[]) {
  return [...list].sort((a, b) => {
    if (a.status === "Available" && b.status !== "Available") return -1;
    if (a.status !== "Available" && b.status === "Available") return 1;
    return (a.order ?? 99) - (b.order ?? 99);
  });
}

const kittens = sortKittens(
  (sanityKittens.length > 0 ? sanityKittens : fallbackKittens).filter(
    (k: any) => k.status === "Available"
  )
);
---

<section id="kittens" class="py-16 md:py-24 bg-obsidian text-bone">
  <div class="max-w-6xl mx-auto px-4">
    <ScrollReveal animation="fadeUp">
      <div class="text-center mb-12 md:mb-16">
        <p class="text-xs md:text-sm font-medium tracking-[0.3em] uppercase text-gold/70 mb-4">
          Spring 2026
        </p>
        <h2 class="font-heading text-4xl md:text-5xl font-semibold text-bone mb-4 leading-tight">
          Current Litter
        </h2>
        <p class="text-bone/60 text-sm md:text-base tracking-wide">
          Born March 12, 2026 · CFA x TICA · Ready June 4 – July 8
        </p>
        <p class="text-bone/40 text-xs md:text-sm tracking-wide mt-2">
          European Championship Bloodlines · HCM Echo-Negative Parents
        </p>
        <p class="font-heading italic text-bone/75 text-base md:text-lg tracking-wide mt-6">
          Welcoming two? Littermates settle in faster together, and we take $1,000 off when you bring home a{" "}
          <a href="#quick-inquiry" class="text-gold/70 hover:text-gold underline underline-offset-2 transition-colors">pair</a>.
        </p>
      </div>
    </ScrollReveal>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {kittens.map((kitten: any, i: number) => (
        <ScrollReveal animation="fadeUp" delay={i * 0.08}>
          <KittenCard
            name={kitten.name}
            slug={kitten.slug}
            sex={kitten.sex}
            color={kitten.color ?? ""}
            bowTieColor={kitten.bowTieColor}
            personality={kitten.personality}
            shortStory={kitten.shortStory}
            about={kitten.about}
            status={kitten.status}
            image={kitten.image?.asset?.url}
            gallery={kitten.gallery}
            price={kitten.price}
            isPolydactyl={kitten.isPolydactyl}
            availableDate={kitten.availableDate}
            variant="dark"
            personalityAssessment={kitten.personalityAssessment}
            phone={settings.phone}
          />
        </ScrollReveal>
      ))}
    </div>

    <p class="text-center text-bone/30 text-sm mt-10">
      Photos added as kittens are weaned and individual personalities emerge. Check back weekly.
    </p>
  </div>
</section>

<!-- Lightbox -->
<div id="kitten-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90" aria-modal="true" role="dialog">
  <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl leading-none" aria-label="Close">&times;</button>
  <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-3xl md:text-5xl leading-none px-3" aria-label="Previous">&#8249;</button>
  <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-3xl md:text-5xl leading-none px-3" aria-label="Next">&#8250;</button>
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[85vw] object-contain" />
  <div id="lightbox-counter" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/40 text-sm tracking-widest"></div>
</div>

<script>
  const lightbox = document.getElementById('kitten-lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCounter = document.getElementById('lightbox-counter') as HTMLElement;
  let images: string[] = [];
  let currentIndex = 0;
  let lastFocusedElement: HTMLElement | null = null;

  function openLightbox(imgs: string[], idx: number, name: string) {
    images = imgs;
    currentIndex = idx;
    lastFocusedElement = document.activeElement as HTMLElement;
    showImage();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    lightboxImg.alt = name + ' Maine Coon kitten';
    document.getElementById('lightbox-close')!.focus();
  }

  function showImage() {
    lightboxImg.src = images[currentIndex];
    const prev = document.getElementById('lightbox-prev') as HTMLElement;
    const next = document.getElementById('lightbox-next') as HTMLElement;
    if (images.length > 1) {
      lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
      prev.style.display = '';
      next.style.display = '';
    } else {
      lightboxCounter.textContent = '';
      prev.style.display = 'none';
      next.style.display = 'none';
    }
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    images = [];
    lastFocusedElement?.focus();
  }

  document.getElementById('lightbox-close')!.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    showImage();
  });
  document.getElementById('lightbox-next')!.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % images.length;
    showImage();
  });
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { currentIndex = (currentIndex - 1 + images.length) % images.length; showImage(); }
    if (e.key === 'ArrowRight') { currentIndex = (currentIndex + 1) % images.length; showImage(); }
  });

  let touchStartX = 0;
  lightbox.addEventListener('touchstart', (e) => { touchStartX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
  lightbox.addEventListener('touchend', (e) => {
    const dx = (e as TouchEvent).changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50 && images.length > 1) {
      if (dx < 0) { currentIndex = (currentIndex + 1) % images.length; }
      else { currentIndex = (currentIndex - 1 + images.length) % images.length; }
      showImage();
    }
  });

  document.querySelectorAll('[data-lightbox-trigger]').forEach(el => {
    if (!el.closest('#kittens')) return;
    el.addEventListener('click', () => {
      const imgs: string[] = JSON.parse((el as HTMLElement).dataset.lightboxImages || '[]');
      const name = (el as HTMLElement).dataset.lightboxName || '';
      const startIdx = parseInt((el as HTMLElement).dataset.lightboxIndex || '0', 10);
      if (imgs.length > 0) openLightbox(imgs, startIdx, name);
    });
    el.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        const imgs: string[] = JSON.parse((el as HTMLElement).dataset.lightboxImages || '[]');
        const name = (el as HTMLElement).dataset.lightboxName || '';
        const startIdx = parseInt((el as HTMLElement).dataset.lightboxIndex || '0', 10);
        if (imgs.length > 0) openLightbox(imgs, startIdx, name);
      }
    });
  });

  // Kitten photo carousels: CSS scroll-snap track, arrows, dots, keyboard nav.
  document.querySelectorAll('[data-kitten-carousel]').forEach(carousel => {
    const el = carousel as HTMLElement;
    if (!el.closest('#kittens')) return;

    const track = el.querySelector('[data-carousel-track]') as HTMLElement | null;
    if (!track) return;

    const slides = Array.from(el.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(el.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
    const dotVisuals = Array.from(el.querySelectorAll<HTMLElement>('[data-carousel-dot-visual]'));
    const prevBtn = el.querySelector('[data-carousel-prev]') as HTMLElement | null;
    const nextBtn = el.querySelector('[data-carousel-next]') as HTMLElement | null;
    if (slides.length < 2) return;

    let current = 0;
    let scrollTimeout: ReturnType<typeof setTimeout> | null = null;

    function setActive(idx: number) {
      current = idx;
      dotVisuals.forEach((dot, i) => {
        dot.classList.toggle('opacity-90', i === idx);
        dot.classList.toggle('opacity-40', i !== idx);
      });
    }

    function goTo(idx: number, smooth = true) {
      const clamped = (idx + slides.length) % slides.length;
      track!.scrollTo({ left: clamped * track!.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
      setActive(clamped);
    }

    track.addEventListener('scroll', () => {
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const width = track!.clientWidth || 1;
        const idx = Math.round(track!.scrollLeft / width);
        setActive(Math.max(0, Math.min(slides.length - 1, idx)));
      }, 100);
    }, { passive: true });

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    track.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'ArrowLeft') {
        e.preventDefault();
        goTo(current - 1);
      } else if (key === 'ArrowRight') {
        e.preventDefault();
        goTo(current + 1);
      } else if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        const activeSlide = slides[current];
        const imgs: string[] = JSON.parse(activeSlide.dataset.lightboxImages || '[]');
        const name = activeSlide.dataset.lightboxName || '';
        if (imgs.length > 0) openLightbox(imgs, current, name);
      }
    });

    window.addEventListener('resize', () => {
      goTo(current, false);
    });

    // No custom touch JS, no touch-action restriction. The track has
    // overflow-x but no overflow-y, so a vertical drag has nothing to scroll
    // locally and the browser hands it to the page automatically. A
    // horizontal drag finds the track's own horizontal overflow and scrolls
    // it. This is the browser's default nested-scroll-container behavior
    // (the same thing that makes any horizontal image strip inside a
    // vertically-scrolling page work without special CSS) — native scrolling
    // handles momentum, snapping, and the tap/drag distinction on its own.
    // touch-action:pan-x was tried here and tested broken: on a CDP-driven
    // real touch gesture it correctly enabled horizontal scroll but silently
    // ate vertical swipes instead of letting them bubble to the page.
  });

  // Kitten card "read more" / "read less": each button toggles only its own
  // paragraph's rest-text span via closest(), so cards expand independently.
  // The rest span animates open with a max-height transition, measured from
  // its own scrollHeight (which reports the full content height even while
  // clipped by overflow-hidden) — a 0fr/1fr grid-template-rows transition was
  // tried first but didn't animate reliably, so this is the fallback.
  document.querySelectorAll('[data-excerpt-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.closest('p');
      if (!p) return;
      const rest = p.querySelector('[data-excerpt-rest]') as HTMLElement | null;
      const ellipsis = p.querySelector('[data-excerpt-ellipsis]') as HTMLElement | null;
      if (!rest) return;

      const expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        rest.style.maxHeight = '0px';
        ellipsis?.classList.remove('hidden');
        btn.textContent = 'read more';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        rest.style.maxHeight = `${rest.scrollHeight}px`;
        ellipsis?.classList.add('hidden');
        btn.textContent = 'read less';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
