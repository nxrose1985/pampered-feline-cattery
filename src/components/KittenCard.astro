---
interface PersonalityAssessment {
  assessmentDate?: string;
  confidenceLevel?: number;
  energyLevel?: string;
  approachesHumans?: string;
  lapCat?: string;
  toyDrive?: string;
  hotDogTest?: string;
  goodWithKids?: string;
  goodWithDogs?: string;
  personalitySummary?: string;
}

interface Props {
  name: string;
  slug?: string;
  sex: string;
  color: string;
  bowTieColor?: "Teal" | "Emerald" | "Burnt Orange";
  personality?: string;
  shortStory?: string;
  status: "Available" | "Reserved" | "Under Evaluation" | "Placed";
  image?: string;
  gallery?: Array<{ asset: { url: string } }>;
  price?: number;
  isPolydactyl?: boolean;
  availableDate?: string;
  variant?: "light" | "dark";
  personalityAssessment?: PersonalityAssessment;
  linkTo?: string;
  phone?: string;
}

const {
  name,
  slug,
  sex,
  color,
  bowTieColor,
  personality,
  shortStory,
  status,
  image,
  gallery,
  price,
  isPolydactyl,
  availableDate,
  variant = "light",
  personalityAssessment,
  linkTo,
  phone,
} = Astro.props;

const bowTieSwatch: Record<string, string> = {
  Teal: "#0d9488",
  Emerald: "#059669",
  "Burnt Orange": "#c2410c",
};

const blurb = shortStory || personality;

function telHref(p: string): string {
  return `tel:${p.replace(/[^\d+]/g, "")}`;
}

const meetHref = slug ? `/kittens/${slug}` : null;

const galleryUrls = (gallery ?? []).map((g) => g.asset.url).filter(Boolean);
const allImages = image ? [image, ...galleryUrls] : galleryUrls;

function sanityCardUrl(url: string): string {
  if (!url || !url.includes('cdn.sanity.io')) return url;
  return `${url}?w=800&q=80&auto=format`;
}
const displayImages = allImages.map(sanityCardUrl);

const pa = personalityAssessment;
const hasAssessment = pa && (pa.personalitySummary || pa.confidenceLevel || pa.energyLevel);

function formatAssessmentDate(d?: string) {
  if (!d) return null;
  const match = /^\d{4}-\d{2}-\d{2}$/.test(d);
  if (!match) return d;
  const [, m, day] = d.split("-").map(Number);
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${months[m - 1]} ${day}`;
}

const isDark = variant === "dark";

const statusColorsLight: Record<string, string> = {
  "Available": "bg-green/10 text-green",
  "Reserved": "bg-gold/10 text-gold-dark",
  "Under Evaluation": "bg-charcoal/10 text-charcoal-light",
  "Placed": "bg-charcoal/5 text-charcoal-light/50",
};

const statusColorsDark: Record<string, string> = {
  "Available": "bg-green-light/25 text-bone",
  "Reserved": "bg-gold/20 text-gold",
  "Under Evaluation": "bg-bone/10 text-bone/70",
  "Placed": "bg-bone/5 text-bone/40",
};

const statusClass = (isDark ? statusColorsDark : statusColorsLight)[status];

function formatPrice(p?: number) {
  if (p === undefined || p === null) return null;
  if (p === 0) return "[PLACEHOLDER — price]";
  return `$${p.toLocaleString("en-US")}`;
}

function formatDate(d?: string) {
  if (!d) return null;
  const match = /^\d{4}-\d{2}-\d{2}$/.test(d);
  if (!match) return d;
  const [y, m, day] = d.split("-").map(Number);
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${months[m - 1]} ${day}, ${y}`;
}

const priceLabel = formatPrice(price);
const dateLabel = formatDate(availableDate);
---

<div
  class={`rounded-sm overflow-hidden ${isDark ? "bg-bone/[0.04] border border-bone/10" : "bg-ivory-warm"} ${linkTo ? "cursor-pointer" : ""}`}
  {...linkTo ? { onclick: `window.location='${linkTo}'` } : {}}
>
  {allImages.length > 0 ? (
    <div
      class={`relative aspect-square overflow-hidden ${isDark ? "bg-bone/[0.03]" : "bg-charcoal/5"}`}
      data-kitten-carousel
    >
      <div
        class="flex h-full overflow-x-auto snap-x snap-mandatory scroll-smooth [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden cursor-pointer focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-gold"
        data-carousel-track
        tabindex="0"
        aria-roledescription="carousel"
        aria-label={`Photos of ${name}, ${color} Maine Coon kitten, ${allImages.length} photo${allImages.length === 1 ? "" : "s"}`}
      >
        {displayImages.map((src, i) => (
          <div
            class="w-full h-full shrink-0 snap-center"
            data-carousel-slide={i}
            data-lightbox-images={JSON.stringify(allImages)}
            data-lightbox-name={name}
            data-lightbox-trigger=""
            data-lightbox-index={i}
          >
            <img
              src={src}
              alt={`${name}, ${color} Maine Coon kitten, photo ${i + 1} of ${allImages.length}`}
              class="w-full h-full object-cover pointer-events-none"
              loading={i === 0 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>

      {isPolydactyl && (
        <span class={`absolute top-4 left-4 px-3 py-1 text-xs font-medium uppercase tracking-widest rounded-sm z-20 pointer-events-none ${isDark ? "bg-gold/20 text-gold" : "bg-charcoal text-ivory"}`}>
          Polydactyl
        </span>
      )}

      <span class={`absolute top-4 right-4 px-3 py-1 text-xs font-medium uppercase tracking-widest rounded-sm z-20 pointer-events-none ${statusClass}`}>
        {status}
      </span>

      {allImages.length > 1 && (
        <>
          <button
            type="button"
            class="absolute left-2 top-1/2 -translate-y-1/2 z-20 hidden sm:flex items-center justify-center w-8 h-8 rounded-full bg-black/40 text-white/80 hover:text-white hover:bg-black/60 transition-colors"
            data-carousel-prev
            aria-label={`Previous photo of ${name}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button
            type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 z-20 hidden sm:flex items-center justify-center w-8 h-8 rounded-full bg-black/40 text-white/80 hover:text-white hover:bg-black/60 transition-colors"
            data-carousel-next
            aria-label={`Next photo of ${name}`}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </button>
          <div class="absolute bottom-1 left-1/2 -translate-x-1/2 flex z-20">
            {allImages.map((_, i) => (
              <button
                type="button"
                class="flex items-center justify-center w-6 h-6"
                data-carousel-dot={i}
                aria-label={`Go to photo ${i + 1} of ${name}`}
              >
                <span
                  class={`block w-1.5 h-1.5 rounded-full transition-opacity pointer-events-none ${i === 0 ? "bg-white opacity-90" : "bg-white opacity-40"}`}
                  data-carousel-dot-visual={i}
                />
              </button>
            ))}
          </div>
        </>
      )}
    </div>
  ) : (
    <div class={`relative aspect-square flex items-center justify-center ${isDark ? "bg-bone/[0.03]" : "bg-charcoal/5"}`}>
      <div class="text-center px-6">
        <svg class={`w-12 h-12 mx-auto mb-2 ${isDark ? "text-bone/20" : "text-charcoal/20"}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class={`text-xs uppercase tracking-widest ${isDark ? "text-bone/30" : "text-charcoal/30"}`}>Photo Coming Soon</p>
      </div>

      {isPolydactyl && (
        <span class={`absolute top-4 left-4 px-3 py-1 text-xs font-medium uppercase tracking-widest rounded-sm ${isDark ? "bg-gold/20 text-gold" : "bg-charcoal text-ivory"}`}>
          Polydactyl
        </span>
      )}

      <span class={`absolute top-4 right-4 px-3 py-1 text-xs font-medium uppercase tracking-widest rounded-sm ${statusClass}`}>
        {status}
      </span>
    </div>
  )}

  <div class="p-6">
    <h3 class={`font-heading text-2xl font-semibold mb-1 ${isDark ? "text-bone" : "text-charcoal"}`}>{name}</h3>
    <p class={`text-sm uppercase tracking-widest mb-1 ${isDark ? "text-gold" : "text-gold-dark"}`}>{color}</p>
    <p class={`flex items-center gap-2 text-sm mb-4 ${isDark ? "text-bone/60" : "text-charcoal-light/70"}`}>
      {sex}
      {bowTieColor && (
        <span class="inline-flex items-center gap-1.5 text-xs">
          <span class="text-bone/20">·</span>
          <span class="w-2.5 h-2.5 rounded-full border border-white/20" style={`background-color: ${bowTieSwatch[bowTieColor]}`} />
          {bowTieColor} Bow Tie
        </span>
      )}
    </p>

    {(priceLabel || dateLabel) && (
      <dl class={`text-xs uppercase tracking-widest space-y-1 mb-4 ${isDark ? "text-bone/70" : "text-charcoal-light"}`}>
        {priceLabel && (
          <div class="flex justify-between gap-4">
            <dt class={isDark ? "text-bone/40" : "text-charcoal-light/60"}>Price</dt>
            <dd class="font-medium">{priceLabel}</dd>
          </div>
        )}
        {dateLabel && (
          <div class="flex justify-between gap-4">
            <dt class={isDark ? "text-bone/40" : "text-charcoal-light/60"}>Ready</dt>
            <dd class="font-medium">{dateLabel}</dd>
          </div>
        )}
      </dl>
    )}

    {blurb && !pa?.personalitySummary && (
      <p class={`leading-relaxed mb-2 ${isDark ? "text-bone/80" : "text-charcoal-light"}`}>{blurb}</p>
    )}

    {meetHref && (
      <a
        href={meetHref}
        class={`inline-flex items-center gap-1 text-xs font-medium uppercase tracking-widest mb-4 transition-colors ${isDark ? "text-gold/70 hover:text-gold" : "text-gold-dark/70 hover:text-gold-dark"}`}
      >
        Read {name}'s full story
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}

    {hasAssessment && (
      <div class={`mb-4 pt-4 border-t ${isDark ? "border-bone/10" : "border-charcoal/10"}`}>
        {pa?.personalitySummary && (
          <p class={`leading-relaxed mb-4 ${isDark ? "text-bone/80" : "text-charcoal-light"}`}>{pa.personalitySummary}</p>
        )}

        <dl class={`grid grid-cols-2 gap-x-4 gap-y-2 text-xs ${isDark ? "text-bone/70" : "text-charcoal-light"}`}>
          {pa?.confidenceLevel && (
            <div class="col-span-2">
              <dt class={`uppercase tracking-widest mb-1 ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Confidence</dt>
              <dd class="flex items-center gap-0.5">
                {Array.from({ length: 10 }, (_, i) => (
                  <span class={`w-2 h-2 rounded-full ${i < (pa?.confidenceLevel ?? 0) ? (isDark ? "bg-gold" : "bg-gold-dark") : (isDark ? "bg-bone/15" : "bg-charcoal/10")}`} />
                ))}
                <span class={`ml-2 text-xs ${isDark ? "text-bone/50" : "text-charcoal-light/60"}`}>{pa.confidenceLevel}/10</span>
              </dd>
            </div>
          )}
          {pa?.energyLevel && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Energy</dt>
              <dd class="font-medium mt-0.5">{pa.energyLevel}</dd>
            </div>
          )}
          {pa?.approachesHumans && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>With People</dt>
              <dd class="font-medium mt-0.5">{pa.approachesHumans}</dd>
            </div>
          )}
          {pa?.lapCat && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Lap Cat</dt>
              <dd class="font-medium mt-0.5">{pa.lapCat}</dd>
            </div>
          )}
          {pa?.hotDogTest && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Food Motivated</dt>
              <dd class="font-medium mt-0.5">{pa.hotDogTest}</dd>
            </div>
          )}
          {pa?.goodWithKids && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Kids</dt>
              <dd class="font-medium mt-0.5">{pa.goodWithKids}</dd>
            </div>
          )}
          {pa?.goodWithDogs && (
            <div>
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Dogs</dt>
              <dd class="font-medium mt-0.5">{pa.goodWithDogs}</dd>
            </div>
          )}
          {pa?.toyDrive && (
            <div class="col-span-2">
              <dt class={`uppercase tracking-widest ${isDark ? "text-bone/40" : "text-charcoal-light/60"}`}>Play</dt>
              <dd class="font-medium mt-0.5">{pa.toyDrive}</dd>
            </div>
          )}
        </dl>

        {pa?.assessmentDate && (
          <p class={`mt-3 text-xs ${isDark ? "text-bone/30" : "text-charcoal-light/40"}`}>
            Assessed {formatAssessmentDate(pa.assessmentDate)}
          </p>
        )}
      </div>
    )}

    {phone && (
      <p class={`text-xs uppercase tracking-widest mb-4 ${isDark ? "text-bone/50" : "text-charcoal-light/60"}`}>
        Call/Text{" "}
        <a
          href={telHref(phone)}
          class={`font-medium underline underline-offset-2 ${isDark ? "text-bone hover:text-gold" : "text-charcoal hover:text-gold-dark"}`}
        >
          {phone}
        </a>
      </p>
    )}

    <div class={`flex flex-col gap-2 ${meetHref || (status === "Available" && !linkTo) ? "" : "hidden"}`}>
      {meetHref && (
        <a
          href={meetHref}
          class={`inline-block w-full text-center px-6 py-2 text-xs font-medium tracking-widest uppercase transition-colors ${
            status === "Available" && !linkTo
              ? (isDark ? "bg-bone text-obsidian hover:bg-bone/90" : "bg-charcoal text-ivory hover:bg-charcoal/90")
              : `border ${isDark ? "border-bone/30 text-bone/60 hover:border-bone/60 hover:text-bone" : "border-charcoal/30 text-charcoal/60 hover:border-charcoal hover:text-charcoal"}`
          }`}
        >
          Meet {name}
        </a>
      )}
      {status === "Available" && !linkTo && (
        <a
          href="#quick-inquiry"
          data-quick-inquiry-trigger=""
          data-quick-inquiry-kitten={name}
          class={`inline-block w-full text-center px-6 py-2 border text-xs font-medium tracking-widest uppercase transition-colors ${
            isDark
              ? "border-bone/30 text-bone/60 hover:border-bone/60 hover:text-bone"
              : "border-charcoal/30 text-charcoal/60 hover:border-charcoal hover:text-charcoal"
          }`}
        >
          Text us about {name}
        </a>
      )}
    </div>
  </div>
</div>
