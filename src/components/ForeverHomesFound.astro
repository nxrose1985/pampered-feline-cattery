---
import ScrollReveal from "./ScrollReveal.astro";
import { getKittensByLitter } from "../lib/sanity";
import type { Kitten } from "../lib/sanity";

interface Props {
  litterId?: string;
  /* Lets the caller keep the page's obsidian / obsidian-soft alternation intact
     when a section is inserted above this one. */
  background?: "obsidian" | "obsidian-soft";
}

const { litterId = "march-2026", background = "obsidian-soft" } = Astro.props;
const bgClass = background === "obsidian" ? "bg-obsidian" : "bg-obsidian-soft";

const sanityKittens = await getKittensByLitter(litterId);

// Was 6, which silently dropped the 7th Placed kitten. Sized to hold the spring
// litter (8) plus the winter litter (8) plus headroom, and it lands on an exact
// row boundary at the desktop 6-up wrap. If a future litter ever pushes past
// this, raise it — the cap exists only so the section can't grow unbounded.
const MAX_SHOWN = 24;

const placedKittens = sanityKittens
  .filter((k: Kitten) => k.status === "Placed")
  .sort((a: Kitten, b: Kitten) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, MAX_SHOWN);

function sanityCardUrl(url: string): string {
  if (!url || !url.includes("cdn.sanity.io")) return url;
  return `${url}?w=500&q=75&auto=format`;
}
---

{placedKittens.length > 0 && (
  <section id="forever-homes-found" class={`py-16 md:py-20 ${bgClass} text-bone`}>
    <div class="max-w-6xl mx-auto px-4">
      <ScrollReveal animation="fadeUp">
        <div class="text-center mb-10 md:mb-12">
          <p class="text-xs md:text-sm font-medium tracking-[0.3em] uppercase text-gold/70 mb-4">
            Happily Ever After
          </p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-bone mb-4 leading-tight">
            Forever Homes Found
          </h2>
          <p class="text-bone/60 text-sm md:text-base leading-relaxed max-w-xl mx-auto mb-6">
            These little ones have found their forever families. Join the waitlist for our next litter.
          </p>
          <a
            href="#waitlist"
            class="inline-block px-8 py-3 bg-gold text-obsidian text-xs font-medium tracking-widest uppercase hover:bg-gold/85 transition-colors"
          >
            Join the Waitlist
          </a>
        </div>
      </ScrollReveal>

      <div class="flex flex-wrap justify-center gap-4 md:gap-5">
        {placedKittens.map((kitten: Kitten, i: number) => (
          <ScrollReveal animation="fadeUp" delay={i * 0.06} class="w-[140px] md:w-[160px]">
            <a
              href={kitten.slug ? `/kittens/${kitten.slug}` : "#"}
              class="group block rounded-sm overflow-hidden bg-bone/[0.03] border border-bone/10 hover:border-amber-warm/30 transition-colors"
            >
              <div class="relative aspect-square overflow-hidden bg-bone/[0.03]">
                {kitten.image?.asset?.url ? (
                  <img
                    src={sanityCardUrl(kitten.image.asset.url)}
                    alt={`${kitten.name}, ${kitten.color} Maine Coon kitten, now in their forever home`}
                    class="w-full h-full object-cover opacity-75 saturate-[0.8] group-hover:opacity-100 group-hover:saturate-100 transition-all duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-bone/15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                <!-- Pure CSS over the live Sanity image: a scrim that settles the
                     photo back so the caption reads as the subject, and a hairline
                     that picks up the seasonal accent. Carries no text, so it has
                     no contrast requirement of its own. -->
                <div
                  class="absolute inset-0 bg-gradient-to-t from-obsidian/75 via-obsidian/10 to-transparent group-hover:from-obsidian/45 transition-all duration-500"
                  aria-hidden="true"
                ></div>
                <div class="absolute inset-x-0 bottom-0 h-px bg-amber-warm/40" aria-hidden="true"></div>
              </div>
              <div class="px-3 py-2.5">
                <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-amber-warm mb-1">Home</p>
                <h3 class="font-heading text-sm font-semibold text-bone/80 truncate">{kitten.name}</h3>
                <p class="text-[11px] text-bone/60 truncate">{kitten.color} · {kitten.sex}</p>
              </div>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>
)}
