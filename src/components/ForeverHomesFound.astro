---
import ScrollReveal from "./ScrollReveal.astro";
import { getKittensByLitter } from "../lib/sanity";
import type { Kitten } from "../lib/sanity";

interface Props {
  litterId?: string;
}

const { litterId = "march-2026" } = Astro.props;

const sanityKittens = await getKittensByLitter(litterId);

const MAX_SHOWN = 6;

const placedKittens = sanityKittens
  .filter((k: Kitten) => k.status === "Placed")
  .sort((a: Kitten, b: Kitten) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, MAX_SHOWN);

function sanityCardUrl(url: string): string {
  if (!url || !url.includes("cdn.sanity.io")) return url;
  return `${url}?w=500&q=75&auto=format`;
}
---

{placedKittens.length > 0 && (
  <section id="forever-homes-found" class="py-16 md:py-20 bg-[#0f0e0d] text-bone">
    <div class="max-w-6xl mx-auto px-4">
      <ScrollReveal animation="fadeUp">
        <div class="text-center mb-10 md:mb-12">
          <p class="text-xs md:text-sm font-medium tracking-[0.3em] uppercase text-gold/70 mb-4">
            Happily Ever After
          </p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-bone mb-4 leading-tight">
            Forever Homes Found
          </h2>
          <p class="text-bone/60 text-sm md:text-base leading-relaxed max-w-xl mx-auto mb-6">
            These little ones have found their forever families. Join the waitlist for our next litter.
          </p>
          <a
            href="#waitlist"
            class="inline-block px-8 py-3 bg-gold text-obsidian text-xs font-medium tracking-widest uppercase hover:bg-gold/85 transition-colors"
          >
            Join the Waitlist
          </a>
        </div>
      </ScrollReveal>

      <div class="grid justify-center gap-4 md:gap-5 grid-cols-[repeat(auto-fit,minmax(140px,160px))]">
        {placedKittens.map((kitten: Kitten, i: number) => (
          <ScrollReveal animation="fadeUp" delay={i * 0.06}>
            <a
              href={kitten.slug ? `/kittens/${kitten.slug}` : "#"}
              class="group block rounded-sm overflow-hidden bg-bone/[0.03] border border-bone/10"
            >
              <div class="relative aspect-square overflow-hidden bg-bone/[0.03]">
                {kitten.image?.asset?.url ? (
                  <img
                    src={sanityCardUrl(kitten.image.asset.url)}
                    alt={`${kitten.name}, ${kitten.color} Maine Coon kitten`}
                    class="w-full h-full object-cover opacity-80 grayscale-[15%] group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-bone/15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                <span class="absolute top-2 right-2 px-2 py-0.5 text-[10px] font-medium uppercase tracking-widest rounded-sm bg-bone/5 text-bone/40">
                  Placed
                </span>
              </div>
              <div class="px-3 py-2.5">
                <h3 class="font-heading text-sm font-semibold text-bone/80 truncate">{kitten.name}</h3>
                <p class="text-[11px] text-bone/40 truncate">{kitten.color} · {kitten.sex}</p>
              </div>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>
)}
