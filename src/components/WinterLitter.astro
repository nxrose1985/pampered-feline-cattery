---
import ScrollReveal from "./ScrollReveal.astro";
import type { Cat, WinterLitter } from "../lib/sanity";

interface Props {
  winterLitter?: WinterLitter;
  cats?: Cat[];
  /* Lets the section slot into the page's alternating background rhythm from
     wherever it is placed, without editing the component. */
  background?: "obsidian" | "obsidian-soft";
}

const { winterLitter, cats = [], background = "obsidian-soft" } = Astro.props;

const enabled = winterLitter?.enabled ?? true;

// No code-side default copy. Every field is whatever is in Studio, and an empty
// field renders nothing. Until siteSettings is populated the section does not
// appear at all, which is the intended first-deploy behaviour.
const eyebrow = winterLitter?.eyebrow?.trim();
const heading = winterLitter?.heading?.trim();
const body = winterLitter?.body?.trim();
const goHomeWindow = winterLitter?.goHomeWindow?.trim();
const ctaLabel = winterLitter?.ctaLabel?.trim();
const ctaHref = winterLitter?.ctaHref?.trim();
const subCta = winterLitter?.subCta?.trim();

const show = enabled && Boolean(heading);
const showCta = Boolean(ctaLabel && ctaHref);

// The pairing is Aedion x Feyra, matched by name against the existing cat
// documents so the photos stay in sync with whatever is on their profiles.
// If either name is not found the section still renders, just without portraits.
function findCat(name: string): Cat | undefined {
  return cats.find((c) => c.name?.trim().toLowerCase() === name.toLowerCase());
}

const sire = findCat("Aedion");
const dam = findCat("Feyra");

const parents = [
  { cat: sire, role: "Sire" },
  { cat: dam, role: "Dam" },
].filter((p): p is { cat: Cat; role: string } => Boolean(p.cat?.image?.asset?.url));

function sanityCardUrl(url: string): string {
  if (!url || !url.includes("cdn.sanity.io")) return url;
  return `${url}?w=600&q=80&auto=format`;
}

const bgClass = background === "obsidian" ? "bg-obsidian" : "bg-obsidian-soft";
const paragraphs = (body ?? "").split("\n\n").map((p) => p.trim()).filter(Boolean);
---

{show && (
  <section id="winter-litter" class={`relative py-16 md:py-24 ${bgClass} text-bone`}>
    <div class="frost-rule absolute inset-x-0 top-0 h-px" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4">
      <ScrollReveal animation="fadeUp">
        <div class="text-center mb-12 md:mb-16 max-w-3xl mx-auto">
          <p class="text-xs md:text-sm font-medium tracking-[0.3em] uppercase text-gold/70 mb-4">
            {eyebrow}
          </p>
          <h2 class="font-heading text-4xl md:text-5xl font-semibold text-bone mb-6 leading-tight">
            {heading}
          </h2>
          {paragraphs.map((p) => (
            <p class="text-bone/70 text-lg leading-relaxed mb-4 last:mb-0">{p}</p>
          ))}
          {goHomeWindow && (
            <p class="mt-8 inline-block border-t border-b border-amber-warm/30 py-3 px-6 text-amber-warm text-sm md:text-base tracking-wide">
              {goHomeWindow}
            </p>
          )}
        </div>
      </ScrollReveal>

      {parents.length > 0 && (
        <div class="flex flex-wrap justify-center gap-6 md:gap-8 mb-12 md:mb-14">
          {parents.map((parent, i) => (
            <ScrollReveal
              animation="fadeUp"
              delay={i * 0.08}
              class="w-full sm:w-[calc(50%-16px)] max-w-[320px]"
            >
              <figure class="rounded-sm overflow-hidden bg-bone/[0.04] border border-bone/10">
                <div class="aspect-square overflow-hidden bg-bone/[0.03]">
                  <img
                    src={sanityCardUrl(parent.cat.image!.asset.url)}
                    alt={`${parent.cat.name}, ${parent.cat.color} Maine Coon, ${parent.role.toLowerCase()} of our winter litter`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <figcaption class="p-5 text-center">
                  <p class="text-xs uppercase tracking-[0.3em] text-gold/70 mb-2">{parent.role}</p>
                  <h3 class="font-heading text-2xl font-semibold text-bone mb-1">{parent.cat.name}</h3>
                  <p class="text-sm uppercase tracking-widest text-bone/60">{parent.cat.color}</p>
                </figcaption>
              </figure>
            </ScrollReveal>
          ))}
        </div>
      )}

      {(showCta || subCta) && (
        <ScrollReveal animation="fadeUp">
          <div class="text-center">
            {showCta && (
              <a
                href={ctaHref}
                class="inline-block px-8 py-3.5 bg-gold text-obsidian text-sm font-medium tracking-widest uppercase hover:bg-gold/85 transition-colors"
              >
                {ctaLabel}
              </a>
            )}
            {subCta && (
              <p class={`mx-auto max-w-lg text-bone/60 text-sm leading-relaxed${showCta ? " mt-4" : ""}`}>
                {subCta}
              </p>
            )}
          </div>
        </ScrollReveal>
      )}
    </div>
  </section>
)}

<style>
  /* The only new motion in this PR: a slow, low-contrast sheen travelling along
     the hairline at the top of the section. Decorative and aria-hidden. */
  .frost-rule {
    background: linear-gradient(
      90deg,
      rgba(224, 164, 94, 0) 0%,
      rgba(224, 164, 94, 0.35) 50%,
      rgba(224, 164, 94, 0) 100%
    );
    background-size: 200% 100%;
    animation: frost-drift 14s ease-in-out infinite;
  }

  @keyframes frost-drift {
    0%, 100% { background-position: 0% 0; }
    50% { background-position: 100% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frost-rule {
      animation: none;
      background-position: 50% 0;
    }
  }
</style>
