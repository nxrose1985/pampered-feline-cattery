---
import { getSettings } from "../lib/sanity";

const settings = await getSettings();

function telHref(phone: string): string {
  return `tel:${phone.replace(/[^\d+]/g, "")}`;
}

function instagramUrl(handle: string): string {
  return `https://instagram.com/${handle}`;
}

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/#our-cats", label: "Our Cats" },
  { href: "/#kittens", label: "Kittens" },
  { href: "/#health", label: "Health & Ethics" },
  { href: "/#contact", label: "Contact" },
];

const infoLinks = [
  { href: "/kitten-application", label: "Apply for a Kitten" },
  { href: "/bringing-home-your-kitten", label: "Bringing Home Your Kitten" },
  { href: "/kitten-purchase-agreement.pdf", label: "Kitten Purchase Agreement", download: true },
  { href: "/#faq", label: "FAQ" },
];

const linkClass = "text-sm font-medium tracking-widest uppercase text-charcoal-light hover:text-gold-dark transition-colors";
---

<header class="sticky top-0 z-50 bg-ivory/95 backdrop-blur-sm border-b border-gold/10">
  <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="font-heading text-xl md:text-2xl font-semibold tracking-wide text-charcoal">
      Pampered Feline
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 text-charcoal"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class={linkClass}>{link.label}</a>
        </li>
      ))}

      <!-- Info dropdown — hover managed by JS to avoid gap flicker -->
      <li class="relative" id="info-li">
        <button
          class={`${linkClass} flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0`}
          aria-haspopup="true"
          aria-expanded="false"
          id="info-trigger"
        >
          Info
          <svg id="info-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown panel — shown/hidden via JS -->
        <div
          id="info-panel"
          class="absolute right-0 top-full mt-2 hidden min-w-[260px] bg-ivory border border-gold/15 shadow-lg py-2"
          role="menu"
        >
          {infoLinks.map((link) => (
            <a
              href={link.href}
              class="block px-5 py-3 text-sm font-medium tracking-widest uppercase text-charcoal-light hover:text-gold-dark hover:bg-gold/5 transition-colors whitespace-nowrap"
              role="menuitem"
              {...(link.download ? { download: true, target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
            </a>
          ))}
        </div>
      </li>

      {settings.phone && (
        <li>
          <a href={telHref(settings.phone)} class={linkClass}>{settings.phone}</a>
        </li>
      )}

      {settings.instagramHandle && (
        <li>
          <a href={instagramUrl(settings.instagramHandle)} target="_blank" rel="noopener noreferrer" class={linkClass}>Instagram</a>
        </li>
      )}
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gold/10">
    <ul class="flex flex-col px-4 py-4 gap-4">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class={`block ${linkClass}`}>
            {link.label}
          </a>
        </li>
      ))}

      <!-- Info accordion -->
      <li>
        <button
          id="info-accordion-toggle"
          class={`flex items-center justify-between w-full ${linkClass} bg-transparent border-0 p-0 cursor-pointer`}
          aria-expanded="false"
        >
          Info
          <svg id="info-accordion-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <ul id="info-accordion-menu" class="hidden flex-col gap-3 mt-3 pl-4 border-l border-gold/20">
          {infoLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`block ${linkClass}`}
                {...(link.download ? { download: true, target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </li>

      {settings.phone && (
        <li>
          <a href={telHref(settings.phone)} class={`block ${linkClass}`}>{settings.phone}</a>
        </li>
      )}

      {settings.instagramHandle && (
        <li>
          <a href={instagramUrl(settings.instagramHandle)} target="_blank" rel="noopener noreferrer" class={`block ${linkClass}`}>Instagram</a>
        </li>
      )}
    </ul>
  </div>
</header>

<script>
  // ── Mobile hamburger ──────────────────────────────────
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const accordionToggle = document.getElementById("info-accordion-toggle");
  const accordionMenu = document.getElementById("info-accordion-menu");
  const accordionChevron = document.getElementById("info-accordion-chevron");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });

  accordionToggle?.addEventListener("click", () => {
    const expanded = accordionToggle.getAttribute("aria-expanded") === "true";
    accordionToggle.setAttribute("aria-expanded", String(!expanded));
    accordionMenu?.classList.toggle("hidden");
    accordionMenu?.classList.toggle("flex");
    accordionChevron?.classList.toggle("rotate-180");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      accordionMenu?.classList.add("hidden");
      accordionMenu?.classList.remove("flex");
      accordionChevron?.classList.remove("rotate-180");
      accordionToggle?.setAttribute("aria-expanded", "false");
    });
  });

  // ── Desktop Info dropdown with hover delay ────────────
  const infoLi = document.getElementById("info-li");
  const infoPanel = document.getElementById("info-panel");
  const infoTrigger = document.getElementById("info-trigger");
  const infoChevron = document.getElementById("info-chevron");

  let hideTimer: ReturnType<typeof setTimeout> | null = null;

  function showInfo() {
    if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
    infoPanel?.classList.remove("hidden");
    infoTrigger?.setAttribute("aria-expanded", "true");
    infoChevron?.classList.add("rotate-180");
  }

  function scheduleHideInfo() {
    hideTimer = setTimeout(() => {
      infoPanel?.classList.add("hidden");
      infoTrigger?.setAttribute("aria-expanded", "false");
      infoChevron?.classList.remove("rotate-180");
    }, 220);
  }

  infoLi?.addEventListener("mouseenter", showInfo);
  infoLi?.addEventListener("mouseleave", scheduleHideInfo);
  infoPanel?.addEventListener("mouseenter", showInfo);
  infoPanel?.addEventListener("mouseleave", scheduleHideInfo);

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !infoPanel?.classList.contains("hidden")) {
      infoPanel?.classList.add("hidden");
      infoTrigger?.setAttribute("aria-expanded", "false");
      infoChevron?.classList.remove("rotate-180");
      (infoTrigger as HTMLElement)?.focus();
    }
  });
</script>
